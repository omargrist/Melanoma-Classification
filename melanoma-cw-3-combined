    "# --- Metadata preprocessing ---\n",
    "\n",
    "meta_df = df.copy()\n",
    "\n",
    "# Sex: male -> 1, female -> 0, missing -> 0.5\n",
    "meta_df[\"sex\"] = meta_df[\"sex\"].map({\"male\": 1, \"female\": 0}).fillna(0.5)\n",
