    "\n",
    "# ── Load the separate metadata model for ensemble ────────────────────────────\n",
    "class MetadataModel(nn.Module):\n",
    "    def __init__(self, input_dim, n_classes=2):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
